rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A leaderboard entry is just {name, score}; entries are never edited or deleted.
    function validEntry() {
      return request.resource.data.keys().hasOnly(['name', 'score'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 12
          && request.resource.data.score is int
          && request.resource.data.score >= 0
          && request.resource.data.score <= 1000000;
    }

    // Global leaderboard, classic mode (also used by the web version). The app only ever
    // (a) reads the top N scores and (b) adds a new {name, score} entry.
    match /scores/{scoreId} {
      allow get: if true;

      // Top-N queries only (the app asks for 10), so the whole collection can't be dumped.
      allow list: if request.query.limit <= 50;

      allow create: if validEntry();
      allow update, delete: if false;
    }

    // Behind-the-car "highway" mode has its own board: the two modes' scores aren't comparable.
    match /scores_highway/{scoreId} {
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow create: if validEntry();
      allow update, delete: if false;
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
